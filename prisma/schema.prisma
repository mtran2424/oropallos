// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  output        = "../lib/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  // url      = env("DATABASE_URL")
}

enum OrderStatus {
  UNPAID
  PAID
}

enum ProductCategory {
  Red_Wine
  White_Wine
  Rose_Wine
  Sparkling_Wine
  Other_Wine
  Liquor
}

enum ProductSubcategory {
  Dry
  Sweet
  Semi_Sweet
  Dessert
  Cooking
  Vermouth
  Box_Wine
  Whiskey
  Tequila
  Vodka
  Gin
  Rum
  Brandy
  Cordials_Liqueurs_Schnapps
  Ready_To_Drink
  Moonshine
  Cocktails
  Wine_Based_Beverages
  Asian_Wines
  Kosher_Wines
  Mead
  Spirits
}

enum Status {
  Cashed
  Void
}

enum Discount {
  No_Discount
  Tax_Free
  Fifteen_Percent
}

enum ItemType {
  Wine
  Liquor
}

model Product {
  id               String             @id @default(uuid())
  name             String
  description      String?
  category         ProductCategory
  subcategory      ProductSubcategory
  type             String?
  abv              Float?
  size             String             @default("750mL")
  price            Float
  imageUrl         String?
  upc              String?
  favorite         Boolean            @default(false)
  hidden           Boolean            @default(false)
  unitPrice        Int?
  unitCount        Int                @default(0)
  unitsPerCase     Int?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  transactionItems TransactionItem[]
}

model Announcement {
  id        String   @id @default(uuid())
  content   String
  endDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Batch {
  id               String        @id @default(uuid())
  wineGross        Int
  liquorGross      Int
  gross            Int
  tax              Int
  discount         Int
  void             Int
  cashTotal        Int
  creditTotal      Int
  register         String
  archive          Boolean       @default(false)
  cardReceiptTotal Int           @default(0)
  transactions     Transaction[]
  date             DateTime      @default(now())
}

model Transaction {
  id               String            @id @default(uuid())
  status           Status
  transactionItems TransactionItem[]
  batchId          String?
  register         String?
  notes            String?
  wineSubtotal     Int
  liquorSubtotal   Int
  discount         Int
  tax              Int
  taxRate          Int
  total            Int
  cash             Int
  credit           Int
  amountTendered   Int
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  batch Batch? @relation(fields: [batchId], references: [id])
}

model TransactionItem {
  id            String      @id @default(uuid())
  transactionId String
  productId     String?
  name          String
  quantity      Int
  itemPrice     Int
  unitPrice     Int?
  discount      Discount
  type          ItemType
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  product       Product?    @relation(fields: [productId], references: [id])
}

model Config {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  user      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
